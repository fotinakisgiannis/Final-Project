generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  emailVerified DateTime?
  password      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts           Account[]
  sessions           Session[]
  profile            UserProfile?
  dailyLogs          DailyLog[]
  foodEntries        FoodEntry[]
  waterEntries       WaterEntry[]
  weightLogs         WeightLog[]
  voiceLogs          VoiceLog[]
  barcodeEntries     BarcodeEntry[]
  passkeyCredentials PasskeyCredential[]
  favoriteRecipes    FavoriteRecipe[]
  achievements       UserAchievement[]
  streak             UserStreak?

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model UserProfile {
  id               String        @id @default(cuid())
  userId           String        @unique
  age              Int?
  gender           Gender?
  heightCm         Float?
  startWeightKg    Float?
  currentWeightKg  Float?
  targetWeightKg   Float?
  activityLevel    ActivityLevel @default(MODERATELY_ACTIVE)
  goal             FitnessGoal   @default(MAINTAIN)
  dietaryPrefs     String[]
  allergies        String[]
  dailyCalorieGoal Int?
  dailyProteinG    Float?
  dailyCarbsG      Float?
  dailyFatG        Float?
  dailyFiberG      Float?
  dailyWaterMl     Int           @default(2000)
  bmr              Float?
  tdee             Float?
  bmi              Float?
  timezone         String        @default("UTC")
  onboardingDone   Boolean       @default(false)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model DailyLog {
  id             String   @id @default(cuid())
  userId         String
  date           DateTime @db.Date
  totalCalories  Float    @default(0)
  totalProtein   Float    @default(0)
  totalCarbs     Float    @default(0)
  totalFat       Float    @default(0)
  totalFiber     Float    @default(0)
  totalSugar     Float    @default(0)
  totalWaterMl   Int      @default(0)
  nutritionScore Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  foodEntries  FoodEntry[]
  waterEntries WaterEntry[]

  @@unique([userId, date])
  @@map("daily_logs")
}

model FoodEntry {
  id           String     @id @default(cuid())
  userId       String
  dailyLogId   String?
  foodName     String
  brand        String?
  mealType     MealType   @default(SNACK)
  servingSize  Float      @default(1)
  servingUnit  String     @default("serving")
  calories     Float
  protein      Float      @default(0)
  carbs        Float      @default(0)
  fat          Float      @default(0)
  fiber        Float      @default(0)
  sugar        Float      @default(0)
  sodium       Float      @default(0)
  cholesterol  Float      @default(0)
  vitaminA     Float?
  vitaminC     Float?
  calcium      Float?
  iron         Float?
  loggedAt     DateTime   @default(now())
  source       FoodSource @default(MANUAL)
  barcode      String?
  imageUrl     String?
  aiConfidence Float?
  notes        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailyLog DailyLog? @relation(fields: [dailyLogId], references: [id])

  @@map("food_entries")
}

model WaterEntry {
  id         String   @id @default(cuid())
  userId     String
  dailyLogId String?
  amountMl   Int
  loggedAt   DateTime @default(now())
  createdAt  DateTime @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailyLog DailyLog? @relation(fields: [dailyLogId], references: [id])

  @@map("water_entries")
}

model WeightLog {
  id        String   @id @default(cuid())
  userId    String
  weightKg  Float
  loggedAt  DateTime @default(now())
  notes     String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("weight_logs")
}

model Recipe {
  id              String   @id @default(cuid())
  title           String
  description     String?
  imageUrl        String?
  sourceUrl       String?
  calories        Float
  protein         Float    @default(0)
  carbs           Float    @default(0)
  fat             Float    @default(0)
  fiber           Float    @default(0)
  servings        Int      @default(1)
  prepTimeMinutes Int?
  cookTimeMinutes Int?
  ingredients     String[]
  instructions    String[]
  tags            String[]
  dietaryTags     String[]
  cuisine         String?
  difficulty      String?  @default("medium")
  isVerified      Boolean  @default(false)
  isAiGenerated   Boolean  @default(false)
  viewCount       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  favorites FavoriteRecipe[]

  @@map("recipes")
}

model FavoriteRecipe {
  id       String   @id @default(cuid())
  userId   String
  recipeId String
  savedAt  DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([userId, recipeId])
  @@map("favorite_recipes")
}

model BarcodeEntry {
  id        String   @id @default(cuid())
  userId    String
  barcode   String
  foodName  String
  brand     String?
  calories  Float
  protein   Float    @default(0)
  carbs     Float    @default(0)
  fat       Float    @default(0)
  fiber     Float    @default(0)
  scannedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("barcode_entries")
}

model VoiceLog {
  id          String   @id @default(cuid())
  userId      String
  transcript  String
  parsedMeals Json
  loggedAt    DateTime @default(now())
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("voice_logs")
}

model PasskeyCredential {
  id           String   @id @default(cuid())
  userId       String
  credentialId String   @unique
  publicKey    String   @db.Text
  counter      Int      @default(0)
  deviceType   String?
  backedUp     Boolean  @default(false)
  transports   String[]
  createdAt    DateTime @default(now())
  lastUsed     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("passkey_credentials")
}

model Achievement {
  id          String @id @default(cuid())
  name        String
  description String
  icon        String
  category    String
  points      Int    @default(10)
  requirement Json

  userAchievements UserAchievement[]

  @@map("achievements")
}

model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  achievementId String
  unlockedAt    DateTime @default(now())
  notified      Boolean  @default(false)

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id])

  @@unique([userId, achievementId])
  @@map("user_achievements")
}

model UserStreak {
  id              String    @id @default(cuid())
  userId          String    @unique
  currentStreak   Int       @default(0)
  longestStreak   Int       @default(0)
  lastLoggedDate  DateTime?
  totalDaysLogged Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_streaks")
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum ActivityLevel {
  SEDENTARY
  LIGHTLY_ACTIVE
  MODERATELY_ACTIVE
  VERY_ACTIVE
  EXTRA_ACTIVE
}

enum FitnessGoal {
  LOSE_WEIGHT
  MAINTAIN
  GAIN_MUSCLE
  IMPROVE_HEALTH
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
  PRE_WORKOUT
  POST_WORKOUT
}

enum FoodSource {
  MANUAL
  BARCODE
  AI_PHOTO
  VOICE
  USDA
  RECIPE
  SAVED
}
